{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imgfit.local/schema/info.schema.json",
  "title": "imgfit info",
  "description": "Output của `imgfit info <file> --json`. Khi lỗi, lệnh trả ErrorDocument giống result.schema.json.",
  "type": "object",
  "required": [
    "schemaVersion",
    "file",
    "format",
    "keepAs",
    "width",
    "height",
    "storedWidth",
    "storedHeight",
    "orientation",
    "hasAlpha",
    "space",
    "hasProfile",
    "bytes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "file": { "type": "string" },
    "format": { "enum": ["jpeg", "png", "webp", "tiff", "gif", "avif"], "description": "Theo nội dung file, không theo đuôi." },
    "keepAs": { "enum": ["jpg", "png", "webp", "avif", null], "description": "Định dạng output khi --format keep; null nếu không giữ được." },
    "width": { "type": "integer", "description": "Đã áp EXIF orientation." },
    "height": { "type": "integer", "description": "Đã áp EXIF orientation." },
    "storedWidth": { "type": "integer" },
    "storedHeight": { "type": "integer" },
    "orientation": { "type": "integer", "minimum": 1, "maximum": 8 },
    "hasAlpha": { "type": "boolean" },
    "space": { "type": "string" },
    "hasProfile": { "type": "boolean" },
    "bytes": { "type": "integer" }
  }
}
