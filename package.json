{
  "name": "imgfit",
  "version": "0.1.0",
  "description": "Engine xử lý ảnh dùng chung (resize, chuyển định dạng, watermark) trước khi upload. Gọi từ mọi ngôn ngữ qua CLI + JSON.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "imgfit": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./schema/*": "./schema/*"
  },
  "files": [
    "dist",
    "schema",
    "README.md"
  ],
  "engines": {
    "node": ">=20.15.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:core && npm run build:ui",
    "build:core": "tsc -p tsconfig.build.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p ui/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "npm run build && node scripts/bench.mjs",
    "pretest": "npm run build:ui",
    "smoke": "node scripts/smoke-package.mjs",
    "docker": "docker build -t imgfit:0.1.0 ."
  },
  "keywords": [
    "image",
    "resize",
    "optimize",
    "sharp",
    "cli",
    "watermark"
  ],
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^15.1.0",
    "express": "^5.3.0",
    "fast-glob": "^3.3.3",
    "multer": "^2.5.0",
    "p-limit": "^7.3.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
